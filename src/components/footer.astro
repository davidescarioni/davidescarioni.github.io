---
import Icon from "./atoms/icon.astro";

const links = [
	{
		label: "Github",
		url: "https://github.com/davidescarioni",
	},
	{
		label: "Mastodon",
		url: "https://mastodon.social/@scario",
	},
	{
		label: "Bluesky",
		url: "https://bsky.app/profile/scario.bsky.social",
	},
];
---

<footer class="footer">
	<div class="footer__content-left">
		<p>
			Sviluppato con <a href="https://astro.build" target="_blank" rel="noopener noreferrer"
				>Astro</a
			>
		</p>
	</div>
	<div class="footer__content-right">
		{
			links.map((link) => (
				<a
					href={link.url}
					target="_blank"
					title={`Guarda il mio profilo su ${link.label}`}
					rel="noopener noreferrer"
				>
					<Icon name={link.label.toLowerCase()} />
				</a>
			))
		}
	</div>
</footer>
