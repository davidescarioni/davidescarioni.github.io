---
import BlogDate from "./blog-date.astro";

interface CardBlogProps {
  date: string;
  title: string;
  description?: string;
  url: string;
}

type Props = CardBlogProps;

const { date, title, description, url } = Astro.props;
---

<div class="card-blog">
  <BlogDate date={date} />
  <h3 class="card-blog__title"><a href={url}>{title}</a></h3>
  {description && <div class="card-blog__description">{description}</div>}
</div>
