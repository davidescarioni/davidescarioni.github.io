---
import CardBlog from "../components/card-blog.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { type Post } from "../utils/types";

const allPosts = Object.values(import.meta.glob<Post>("./blog/*.md", { eager: true }));

const orderedPosts = allPosts.sort(
	(a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()
);

const pageTitle = "Home Page";
---

<BaseLayout title={pageTitle}>
	<h2>Blog</h2>

	<ul class="blog-post-list" aria-label="Articoli del blog">
		{
			orderedPosts.map((post) => (
				<li class="blog-post-list__item">
					<CardBlog
						date={post.frontmatter.date}
						title={post.frontmatter.title}
						description={post.frontmatter.description}
						tags={post.frontmatter.tags}
						url={post.url}
					/>
				</li>
			))
		}
	</ul>
</BaseLayout>
