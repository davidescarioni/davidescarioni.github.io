---
import BaseLayout from "../layouts/BaseLayout.astro";
import { type Game } from "../utils/types";

const pageTitle = "Games";

const allPosts = Object.values(
	import.meta.glob<Game>("./games/*.md", { eager: true })
);

const orderedGames = allPosts.sort(
	(a, b) =>
		new Date(b.frontmatter.releasedDate).valueOf() -
		new Date(a.frontmatter.releasedDate).valueOf()
);
---

<BaseLayout
	title={pageTitle}
	description="Tutti (o quasi) i giochi che ho sviluppato o ai quali ho partecipato."
>
	<div class="page-details">
		<ul class="card-games-list" aria-label="Articoli del blog">
			{
				orderedGames.map((game) => (
					<li class="card-games-list__item">
						{/* <a href={game.url}>
            <img
              class:list={[
                "card-games-list__item-image",
                game.frontmatter.status === "draft" &&
                  "card-games-list__item-image--draft",
              ]}
              src={game.frontmatter.banner}
              alt={game.frontmatter.title}
            />
            <span class="sr-only">{game.frontmatter.title}</span>
          </a> */}

						<a
							href={game.frontmatter.downloadUrls[0]}
							target="_blank"
							rel="noopener noreferrer"
						>
							<img
								class="card-games-list__item-image"
								src={game.frontmatter.banner}
								alt={game.frontmatter.title}
							/>
							<span class="sr-only">{game.frontmatter.title}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>
